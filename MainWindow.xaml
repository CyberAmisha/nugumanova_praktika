<Window x:Class="DoctorBookingWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись к врачу" Height="650" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F5F1EB">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196*"/>
            <ColumnDefinition Width="309*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,15" Grid.ColumnSpan="2">
            <TextBlock Text="ЗАПИСЬ К ВРАЧУ"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#594735"/>
            <TextBlock x:Name="StatusText"
                       Text="Система учёта пациентов и приёмов"
                       FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" FontSize="14" Grid.ColumnSpan="2">
            <TabItem Header="Пациенты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel>
                        <TextBox x:Name="PatientNameBox" Width="210"
                                 Margin="4" ToolTip="ФИО пациента"/>
                        <TextBox x:Name="PatientPhoneBox" Width="150"
                                 Margin="4" ToolTip="Телефон"/>
                        <Button Content="Добавить" Click="AddPatient_Click"
                                Padding="12,6" Margin="4"/>
                        <Button Content="Удалить" Click="DeletePatient_Click"
                                Padding="12,6" Margin="4"/>
                    </WrapPanel>

                    <TextBox x:Name="PatientSearchBox" Grid.Row="1"
                             Margin="4" Padding="8"
                             ToolTip="Поиск пациента"
                             TextChanged="PatientSearch_TextChanged"/>

                    <DataGrid x:Name="PatientsGrid" Grid.Row="2"
                              Margin="4" AutoGenerateColumns="True"
                              IsReadOnly="True"
                              SelectionMode="Single"/>
                </Grid>
            </TabItem>

            <TabItem Header="Врачи">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel>
                        <TextBox x:Name="DoctorNameBox" Width="190"
                                 Margin="4" ToolTip="ФИО врача"/>
                        <TextBox x:Name="DoctorSpecialtyBox" Width="160"
                                 Margin="4" ToolTip="Специальность"/>
                        <TextBox x:Name="DoctorCabinetBox" Width="100"
                                 Margin="4" ToolTip="Кабинет"/>
                        <Button Content="Добавить врача"
                                Click="AddDoctor_Click"
                                Padding="12,6" Margin="4"/>
                    </WrapPanel>

                    <DataGrid x:Name="DoctorsGrid" Grid.Row="1"
                              Margin="4" AutoGenerateColumns="True"
                              IsReadOnly="True"
                              SelectionMode="Single"/>
                </Grid>
            </TabItem>

            <TabItem Header="Записи на приём">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel>
                        <TextBox x:Name="AppointmentPatientIdBox"
                     Width="100" Margin="4"
                     ToolTip="ID пациента"/>
                        <TextBox x:Name="AppointmentDoctorIdBox"
                     Width="100" Margin="4"
                     ToolTip="ID врача"/>
                        <TextBox x:Name="AppointmentDateBox"
                     Width="170" Margin="4"
                     ToolTip="Дата и время"/>
                        <Button Content="Создать запись"
                    Click="AddAppointment_Click"
                    Padding="12,6" Margin="4"/>
                        <Button Content="Отменить запись"
                    Click="CancelAppointment_Click"
                    Padding="12,6" Margin="4"/>
                    </WrapPanel>

                    <DataGrid x:Name="AppointmentsGrid"
                  Grid.Row="1" Margin="4"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>