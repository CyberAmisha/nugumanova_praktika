<Window x:Class="RestaurantBookingWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Бронирование столиков в ресторане"
        Height="680" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Бронирование столиков"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Background="White"
                Padding="12"
                CornerRadius="8"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Роль:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <ComboBox x:Name="RoleBox"
                          Width="180"
                          Height="30"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Администратор"/>
                    <ComboBoxItem Content="Менеджер"/>
                    <ComboBoxItem Content="Пользователь"/>
                </ComboBox>

                <Button Content="Применить роль"
                        Width="150"
                        Height="32"
                        Margin="12,0,0,0"
                        Click="ApplyRole_Click"/>

                <TextBlock x:Name="RoleInfo"
                           Text="Текущая роль: Администратор"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                Padding="12"
                CornerRadius="8"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Имя клиента" Margin="0,0,0,5"/>
                    <TextBox x:Name="ClientBox"
                             Height="30"
                             Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Столик" Margin="0,0,0,5"/>
                    <ComboBox x:Name="TableBox"
                              Height="30"
                              SelectedIndex="0">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="6"/>
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8"/>
                        <ComboBoxItem Content="9"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="11"/>
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="13"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="15"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="17"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="19"/>
                        <ComboBoxItem Content="20"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="Дата" Margin="0,0,0,5"/>
                    <DatePicker x:Name="DateBox"
                                Height="30"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="5">
                    <TextBlock Text="Время" Margin="0,0,0,5"/>
                    <TextBox x:Name="TimeBox"
                             Text="18:00"
                             Height="30"
                             Padding="5"/>
                </StackPanel>

                <Button x:Name="AddButton"
                        Grid.Column="4"
                        Content="Добавить"
                        Width="110"
                        Height="35"
                        Margin="10,20,0,0"
                        VerticalAlignment="Top"
                        Click="AddBooking_Click"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="3"
                  x:Name="BookingsGrid"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Background="White"
                  RowHeight="32"
                  Margin="0,0,0,12"/>

        <DockPanel Grid.Row="4">
            <TextBlock x:Name="InfoText"
                       Text="Всего бронирований: 0"
                       FontSize="14"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>

            <Button x:Name="CancelButton"
                    Content="Отменить бронирование"
                    Width="200"
                    Height="38"
                    HorizontalAlignment="Right"
                    Click="CancelBooking_Click"/>
        </DockPanel>
    </Grid>
</Window>